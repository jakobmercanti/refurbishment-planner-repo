# Server-only configuration. Railway Docker defaults to public mode.
RENOVATION_FIT_PUBLIC=true
ENABLE_PROGRAMMER_TOOLS=false
ALLOWED_ORIGINS=https://www.freefloorplan3d.com
# Local Next.js proxy only; the static release uses the Cloudflare proxy.
ENGINEERING_API_ORIGIN=http://127.0.0.1:8000
# Public build variables (never put secrets in NEXT_PUBLIC_*).
NEXT_PUBLIC_ENABLE_PROGRAMMER_TOOLS=false
NEXT_PUBLIC_BASE_PATH=/planner-test
NEXT_PUBLIC_API_URL=/planner-test/engineering-api
PLANNER_STATIC_EXPORT=true
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional local FreeCAD installation; CAD is disabled on the public API.
# FREECAD_CMD=C:\Program Files\FreeCAD 26.3\bin\freecadcmd.exe

# Phase 2 commercial API — server secrets stay on the FastAPI/worker services.
# Apply database/migrations/202609240001_phase2_commercial.sql first.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REQUIRE_VERIFIED_EMAIL=true
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Test keys are the default. Live Stripe keys are refused unless explicitly enabled.
STRIPE_ALLOW_LIVE=false
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_MEDIUM_1=
STRIPE_PRICE_MEDIUM_10=
STRIPE_PRICE_MEDIUM_50=
STRIPE_PRICE_MEDIUM_100=
STRIPE_PRICE_HIGH_1=
STRIPE_PRICE_HIGH_10=
STRIPE_PRICE_HIGH_50=
STRIPE_PRICE_HIGH_100=
PUBLIC_APP_URL=https://www.freefloorplan3d.com
PLANNER_BASE_PATH=/planner
OPENAI_API_KEY=

# Set true only on a separate worker service (not on the web/API service).
COMMERCIAL_WORKER_ENABLED=false
COMMERCIAL_WORKER_POLL_SECONDS=3
