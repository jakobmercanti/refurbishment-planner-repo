# Public browser configuration only. Never put a service-role, Stripe or OpenAI key here.
NEXT_PUBLIC_BASE_PATH=/planner
NEXT_PUBLIC_API_URL=/planner/engineering-api
NEXT_PUBLIC_COMMERCIAL_API_URL=/planner/engineering-api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Next development server only: authoritative plan-summary reads, never billing writes.
# Override with your loopback API when using a separate local account database.
COMMERCIAL_READ_API_ORIGIN=https://freefloorplan3d-api-production.up.railway.app
# For local development sharing production accounts, use an allowed HTTPS account URL.
# NEXT_PUBLIC_AUTH_REDIRECT_URL=https://www.freefloorplan3d.com/planner/account/
# Optional server-only development override; defaults to the existing private Railway worker.
# CFD_WORKER_ORIGIN=https://climoptix-openfoam-production.up.railway.app
