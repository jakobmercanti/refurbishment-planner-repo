import test from 'node:test';
import assert from 'node:assert/strict';
import 'fake-indexeddb/auto';
import { PDFDocument } from 'pdf-lib';
import type { Room } from '../lib/types.ts';
import { newEnergyProject, parseEnergyProject, newAssembly } from '../lib/energyDocument.ts';
import { newHeatingProject } from '../lib/heatingDocument.ts';
import { calculateRoomHeatLoss } from '../lib/heatingCalculations.ts';
import { heatingResults, newHeatingRadiator } from '../lib/heatingDesign.ts';
import { addInsulation, assignEnergyElements, calculateLayerResistance, calculateAssemblyUValue, calculateBuildingHeatLossCoefficient, calculateAnnualEnergyEstimate, calculateInsulationUpgrade, compareThermalScenarios, duplicateRetrofitScenario, energyElements, energyResults, findInsulationThickness, withEnergyFabric, withoutDerivedFabric, calculateMaterialQuantities, calculateIndicativeEnergyRating } from '../lib/energyCalculations.ts';
import { newProject, parseProject } from '../lib/projectDocument.ts';
import { exportProject, importProject } from '../lib/projectPackage.ts';
import { LocalProjectRepository } from '../lib/projectRepository.ts';
import { buildEnergyPdf, insulationScheduleCsv } from '../lib/energyExport.ts';
const m = (value:number) => ({value,uncertainty_mm:0,verified:true,source_type:'USER_MEASURED'});
const room:Room={id:'energy-room',name:'Living room',version:1,vertices:[{x:0,y:0},{x:5000,y:0},{x:5000,y:4000},{x:0,y:4000}],wall_height:m(2500),wall_thickness:m(100),openings:[],obstacles:[]};
const near=(a:number,b:number)=>assert.ok(Math.abs(a-b)<1e-7,`${a} != ${b}`);
function upgraded(){const h=newHeatingProject(),e=newEnergyProject();e.scenarios=[{scenarioId:'upgrade',name:'Wall insulation',assignments:[]}];e.activeScenarioId='upgrade';const elements=energyElements([room],h,e).filter(v=>v.category==='wall');return {h,e:addInsulation(e,elements,'pir-tw55',100,'Outside')};}
test('layer resistance and U calculation are transparent, mm authoritative',()=>{const e=newEnergyProject();e.materials[0].lambda=.025;const a=newAssembly();a.layers=[{layerId:'l',materialId:e.materials[0].materialId,thicknessMm:100,resistanceOverride:null,position:'Within',upgrade:false}];a.rsi=.6;a.rse=.4;near(calculateLayerResistance(a.layers[0],e.materials)!,4);near(calculateAssemblyUValue(a,e.materials).uValue!, .2);});
test('unknown conductivity/cavity resistance never silently becomes zero resistance',()=>{const e=newEnergyProject(),a=newAssembly();e.materials.find(m=>m.materialId===a.layers[1].materialId)!.lambda=null;assert.equal(calculateAssemblyUValue(a,e.materials).uValue,null);a.layers[1].resistanceOverride=.5;assert.ok(calculateAssemblyUValue(a,e.materials).uValue!>0);});
test('entered whole-assembly U is explicit and takes precedence over layers',()=>{const e=newEnergyProject(),a=newAssembly();a.directUValue=.3;near(calculateAssemblyUValue(a,e.materials).uValue!,.3);});
test('source-linked geometry and shared Heating inputs reduce exact wall demand',()=>{const h=newHeatingProject(),e=newEnergyProject();const next=assignEnergyElements(e,[{elementId:'energy-room|wall:0',assemblyId:null,uValue:.1}]);const before=calculateRoomHeatLoss(room,[room],h),after=calculateRoomHeatLoss(room,[room],withEnergyFabric(h,next,[room]));near(before.designW-after.designW,12.5*(.3-.1)*24);assert.equal(h.buildingSettings.construction.externalWall,.3);assert.equal(after.ach,before.ach);});
test('individual openings share engine but may have different whole-product U-values',()=>{const r={...room,openings:[{id:'win1',kind:'WINDOW' as const,parent_wall_id:'wall-001',offset_mm:500,width:m(1000),height:m(1000),sill_height_mm:900},{id:'win2',kind:'WINDOW' as const,parent_wall_id:'wall-001',offset_mm:2000,width:m(1000),height:m(1000),sill_height_mm:900}]};const h=newHeatingProject(),e=assignEnergyElements(newEnergyProject(),[{elementId:'energy-room|opening:win1',assemblyId:null,uValue:.8}]);const elements=energyElements([r],h,e);near(elements.find(v=>v.elementId.endsWith('win1'))!.uValue,.8);near(elements.find(v=>v.elementId.endsWith('win2'))!.uValue,1.4);near(elements.find(v=>v.elementId==='energy-room|wall:0')!.areaM2,10.5);});
test('construction boundary override excludes equally heated/party-wall loss',()=>{const h=newHeatingProject(),e=assignEnergyElements(newEnergyProject(),[{elementId:'energy-room|wall:0',assemblyId:null,uValue:1.5,boundary:'Adiabatic'}]);near(energyElements([room],h,e)[0].heatLossW,0);});
test('existing building remains unchanged by proposed insulation; no duplicated surface R',()=>{const {e,h}=upgraded(),before=energyResults([room],h,e,null),after=energyResults([room],h,e);assert.ok(after.designW<before.designW);const wall=after.elements.find(v=>v.elementId==='energy-room|wall:0')!;near(wall.uValue,1/(1/.3+.1/.022));assert.equal(e.existingAssignments.length,0);assert.equal(compareThermalScenarios([room],h,e).length,2);});
test('insulation optimizer derives thickness from actual resistance, not fake lookup values',()=>{near(findInsulationThickness(1.5,.3,.022)!,58.666666666666664);near(calculateInsulationUpgrade(1.5,.022,100)!,1/(1/1.5+.1/.022));near(findInsulationThickness(.2,.3,.022)!,0);});
test('material quantities use opaque authoritative area and separately show order waste',()=>{const {e,h}=upgraded();e.energySettings.wastePercent=10;const rows=calculateMaterialQuantities([room],h,e);near(rows.reduce((s,r)=>s+r.areaM2,0),45);near(rows.reduce((s,r)=>s+r.volumeM3,0),4.5);near(rows.reduce((s,r)=>s+r.orderVolumeM3,0),4.95);});
test('H includes external fabric and shared ventilation, not internal room partitions',()=>{const h=newHeatingProject(),other={...room,id:'second',vertices:room.vertices.map(p=>({...p,x:p.x+5000}))};const c=calculateBuildingHeatLossCoefficient([room,other],h);near(c.ventilation,.33*.5*100);near(c.fabric,70*.3+40*.25+40*.18);});
test('partial shared walls expose separate thermal segments, insulation only changes external part',()=>{const h=newHeatingProject(),e=newEnergyProject(),other={...room,id:'partial',vertices:[{x:5000,y:1000},{x:8000,y:1000},{x:8000,y:3000},{x:5000,y:3000}]};const elements=energyElements([room,other],h,e).filter(v=>v.roomId===room.id&&v.elementId.startsWith('energy-room|wall:1'));assert.equal(elements.length,3);near(elements.find(v=>v.boundary==='Heated')!.areaM2,5);e.scenarios=[{scenarioId:'p',name:'Partial external upgrade',assignments:[]}];e.activeScenarioId='p';const next=addInsulation(e,elements.filter(v=>v.boundary==='External'),'pir-tw55',100,'Outside');parseEnergyProject(next);const before=energyResults([room,other],h,e).designW,after=energyResults([room,other],h,next).designW;near(before-after,5*(.3-1/(1/.3+.1/.022))*24);});
test('annual HDD model requires climate data; known coefficient case is deterministic',()=>{const e=newEnergyProject();assert.equal(calculateAnnualEnergyEstimate(100,e.energySettings),null);Object.assign(e.energySettings,{heatingDegreeDays:2000,climateReference:'Test climate / 15.5 C / 2025',seasonalEfficiency:3,efficiencyBasis:'Test SPF'});const r=calculateAnnualEnergyEstimate(100,e.energySettings)!;near(r.usefulKwh,4800);near(r.deliveredKwh!,1600);e.energySettings.efficiencyBasis='';assert.equal(calculateAnnualEnergyEstimate(100,e.energySettings)!.deliveredKwh,null);});
test('missing proposed inputs keep fallback but Heating capacity is not falsely verified',()=>{const h=newHeatingProject(),e=newEnergyProject(),a=newAssembly();e.materials.find(m=>m.materialId===a.layers[1].materialId)!.lambda=null;e.assemblies=[a];e.existingAssignments=[{elementId:'energy-room|wall:0',assemblyId:a.assemblyId,uValue:null}];const radiator=newHeatingRadiator(room,'Electric');radiator.ratedOutputW=10000;h.radiators=[radiator];const effective=withEnergyFabric(h,e,[room]);assert.equal(heatingResults([room],effective).rooms[0].status,'Not verified');assert.equal(energyResults([room],h,e).verified,false);near(energyElements([room],h,e)[0].uValue,.3);});
test('changed wall topology retains assignment but ignores stale mapping with a warning',()=>{const h=newHeatingProject(),e=assignEnergyElements(newEnergyProject(),[{elementId:'energy-room|wall:0',assemblyId:null,uValue:.1,geometrySignature:JSON.stringify([room.vertices[0],room.vertices[1]])}]);const moved={...room,vertices:room.vertices.map((p,i)=>i===1?{x:6000,y:0}:p)};const r=energyResults([moved],h,e);assert.equal(r.verified,false);near(r.elements[0].uValue,.3);});
test('derived cross-module fabric is never persisted as duplicate Heating data',()=>{const {h,e}=upgraded(),effective=withEnergyFabric(h,e,[room]);assert.ok(effective.thermalOverrides);assert.equal(withoutDerivedFabric(effective).thermalOverrides,undefined);});
test('project autosave and portable package preserve materials, scenarios and assignments',async()=>{const {h,e}=upgraded(),p={...newProject('Energy test'),rooms:[room],heatingLayout:h,energyLayout:e};const parsed=parseProject(p);assert.deepEqual(parsed.energyLayout,e);const repository=new LocalProjectRepository();await repository.saveProject(p);assert.deepEqual((await repository.currentProject())?.energyLayout,e);const blob=await exportProject(p);const restored=await importProject(blob);assert.deepEqual(restored.energyLayout,e);assert.equal(parseProject(newProject()).energyLayout,undefined);});
test('invalid dangling references, nonfinite numbers and duplicate assignments are rejected',()=>{const e=newEnergyProject();e.activeScenarioId='missing';assert.throws(()=>parseEnergyProject(e));e.activeScenarioId=null;e.materials[0].lambda=NaN;assert.throws(()=>parseEnergyProject(e));});
test('duplicate retrofit scenario owns independent proposed constructions',()=>{const {h,e}=upgraded(),copy=duplicateRetrofitScenario(e,'upgrade');const assigned=copy.scenarios[1].assignments[0].assemblyId;const copied=copy.assemblies.find(a=>a.assemblyId===assigned)!;copied.layers.find(l=>l.upgrade)!.thicknessMm=200;assert.notEqual(energyResults([room],h,copy,copy.activeScenarioId).designW,energyResults([room],h,copy,'upgrade').designW);near(energyResults([room],h,copy,'upgrade').designW,energyResults([room],h,e,'upgrade').designW);});
test('indicative rating never invents EPC bands or exact scoring',()=>{assert.equal(calculateIndicativeEnergyRating().score,null);assert.equal(calculateIndicativeEnergyRating().band,null);});
test('current editable scenario exports multi-page white document and safe CSV',async()=>{const {h,e}=upgraded();e.scenarios[0].name='Edited proposal';const pdf=await buildEnergyPdf([room],h,e,'Edited customer project'),document=await PDFDocument.load(pdf);assert.ok(document.getPageCount()>=3);assert.match(insulationScheduleCsv([room],h,e),/0\.127/);if(process.env.ENERGY_PDF_QA==='1'){const fs=await import('node:fs/promises');await fs.writeFile('../.local-logs/energy-qa.pdf',pdf);} });
