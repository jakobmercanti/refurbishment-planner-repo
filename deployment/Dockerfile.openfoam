# OpenCFD's official v2312 runtime, pinned independently of the public API image.
FROM opencfd/openfoam-default:2312@sha256:097e45046a74ee1dae3e6135df0c42723ba55092d246e7c9932f3bfa1e89b7b2
USER root
COPY --from=ghcr.io/astral-sh/uv:0.10.9 /uv /uvx /bin/
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tini util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home --shell /bin/bash cfd
ENV UV_PYTHON_INSTALL_DIR=/opt/python UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv python install 3.12 && uv sync --frozen --no-dev --extra cfd --python 3.12
COPY backend ./backend
COPY geometry ./geometry
COPY database ./database
COPY cad ./cad
COPY fixtures ./fixtures
COPY data ./data
COPY frontend/lib/*.json ./frontend/lib/
COPY deployment/openfoam-entrypoint.sh /usr/local/bin/climoptix-openfoam
RUN chmod 755 /usr/local/bin/climoptix-openfoam
ENV PATH="/app/.venv/bin:${PATH}" PYTHONPATH=/app PYTHONUNBUFFERED=1 \
    CFD_DATA_ROOT=/data/cfd PORT=8080 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
EXPOSE 8080
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/climoptix-openfoam"]
